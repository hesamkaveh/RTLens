{
  "name": "rtlens",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "description": "BiDi lens for terminal output",
  "license": "MIT",
  "author": "Hesam Kaveh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hesamkaveh/RTLens.git"
  },
  "bugs": {
    "url": "https://github.com/hesamkaveh/RTLens/issues"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "harness": "cargo build -p rtlens-core --bin rtlens-dump && python3 scripts/build-harness.py",
    "test": "cargo test -p rtlens-core",
    "test:hud": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit && cargo clippy --workspace --all-targets -- -D warnings"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "vite": "^8.0.16",
    "typescript": "~6.0.3"
  }
}
