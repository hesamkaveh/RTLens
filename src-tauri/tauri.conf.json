{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RTLens",
  "version": "0.1.17",
  "identifier": "com.hesamkaveh.rtlens",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "hud",
        "title": "RTLens",
        "url": "index.html",
        "width": 760,
        "height": 320,
        "minWidth": 380,
        "minHeight": 140,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "resizable": true,
        "visible": false,
        "focus": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "BiDi lens for terminal output",
    "longDescription": "Select mixed Persian/English terminal output, press a hotkey, and read it laid out correctly.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "RTLens"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/hesamkaveh/RTLens/releases/latest/download/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4QTc5MUEyRjU1ODY4RkYKUldUL2FGajFvcEduNkc2Q3ZjelFYWVFQWE1jeHhEbzJJaEFJdTd0cmpUN011blNHUEtjMUREd2EK"
    }
  }
}
