*.pending-snap

# Local scratch captures used while chasing a layout bug. Real regressions get
# distilled into crates/rtlens-core/tests/fixtures instead — raw captures are
# usually somebody's actual terminal output and do not belong in the repo.
corpus/

graphify-out

